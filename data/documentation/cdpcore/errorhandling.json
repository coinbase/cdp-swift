on: \\(msg)\")","","    case .api(let statusCode, let errorType, let message, let correlationId):","        \/\/ Server returned an error","        print(\"API error [\\(statusCode)] \\(errorType): \\(message)\")","        if let id = correlationId {","            print(\"Correlation ID: \\(id)\")  \/\/ Useful for support","        }","","    case .network(let msg):","        \/\/ Network connectivity issue","        print(\"Network: \\(msg)\")","","    case .mfa(let code, let msg):","        \/\/ MFA-related error","        switch code {","        case .superseded: print(\"MFA request replaced\")","        case .cancelled: print(\"MFA cancelled\")","        case .listenerRequired: print(\"Register an MFA listener first\")","        }","","    case .swap(let code, let msg):","        \/\/ Swap-related error","        print(\"Swap error (\\(code)): \\(msg)\")","","    case .customAuth(let msg):","        \/\/ Custom JWT provider error","        print(\"Custom auth: \\(msg)\")","","    case .alreadySignedIn(let msg):","        \/\/ Attempted sign-in while already authenticated","        print(\"Already signed in: \\(msg)\")","","    default:","        print(error.localizedDescription)","    }","}"]},{"type":"heading","text":"LocalizedError Conformance","anchor":"LocalizedError-Conformance","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/CDPCoreError"},{"type":"text","text":" conforms to "},{"code":"LocalizedError","type":"codeVoice"},{"type":"text","text":", so "},{"code":"error.localizedDescription","type":"codeVoice"},{"type":"text","text":" always returns a human-readable message."}]},{"type":"heading","text":"Error Documentation","anchor":"Error-Documentation","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For detailed error codes and troubleshooting, see the "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.cdp.coinbase.com\/errors"