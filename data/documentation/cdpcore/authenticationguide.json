{"hierarchy":{"paths":[["doc:\/\/CDPCore\/documentation\/CDPCore"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cdpcore\/authenticationguide"]}],"metadata":{"modules":[{"name":"CDPCore"}],"roleHeading":"Article","role":"article","title":"Authentication"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"CDPCore supports multiple authentication methods. Each method follows a two-step flow: initiate, then verify.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Email OTP","anchor":"Email-OTP","type":"heading"},{"code":["\/\/ Step 1: Initiate","let result = try await client.signInWithEmail(","    SignInWithEmailOptions(email: \"user@example.com\")",")","","\/\/ Step 2: Verify the OTP code the user received","let verified = try await client.verifyEmailOTP(","    VerifyEmailOTPOptions(flowId: result.flowId, otp: \"123456\")",")","print(\"Signed in as \\(verified.user.userId)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"SMS OTP","anchor":"SMS-OTP","type":"heading"},{"code":["let result = try await client.signInWithSms(","    SignInWithSmsOptions(phoneNumber: \"+14155551234\")",")","let verified = try await client.verifySmsOTP(","    VerifySmsOTPOptions(flowId: result.flowId, otp: \"123456\")",")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"OAuth (Google, Apple)","anchor":"OAuth-Google-Apple","type":"heading"},{"code":["\/\/ Opens the system browser for OAuth","try await client.signInWithOAuth(providerType: .google)","","\/\/ Listen for OAuth completion","await client.onOAuthStateChange { state in","    guard let state, state.status == .success else { return }","    let verified = try await client.verifyOAuth(","        VerifyOAuthOptions(","            flowId: state.flowId!,","            code: state.code!,","            providerType: state.providerType!","        )","    )","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Custom JWT","anchor":"Custom-JWT","type":"heading"},{"inlineContent":[{"text":"When using ","type":"text"},{"identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/CustomAuth","isActive":true,"type":"reference"},{"text":", authentication happens automatically via the JWT callback:","type":"text"}],"type":"paragraph"},{"code":["let config = CDPCoreConfig(","    projectId: \"your-project-id\",","    customAuth: CustomAuth(getJwt: { try await myAuthService.getToken() })",")","let client = try WalletsClient(config: config)","await client.start() \/\/ Authenticates automatically"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Session Management","anchor":"Session-Management","type":"heading"},{"code":["\/\/ Check sign-in state","let signedIn = try await client.isSignedIn()","","\/\/ Get current user","let user = try await client.getCurrentUser()","","\/\/ Listen for auth state changes. The returned token can be used to unsubscribe.","let listenerId = await client.onAuthStateChange { user in","    if let user {","        print(\"Signed in: \\(user.userId)\")","    } else {","        print(\"Signed out\")","    }","}","","\/\/ Later, stop receiving auth state changes.","await client.removeAuthStateChangeListener(listenerId)","","\/\/ Sign out","try await client.signOut()"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Access Tokens","anchor":"Access-Tokens","type":"heading"},{"code":["\/\/ Get the current access token (auto-refreshes if needed)","let token = try await client.getAccessToken()","","\/\/ Force a refresh","let freshToken = try await client.getAccessToken(forceRefresh: true)","","\/\/ Check expiration","let expiration = try await client.getAccessTokenExpiration()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/CDPCore\/documentation\/CDPCore\/AuthState","doc:\/\/CDPCore\/documentation\/CDPCore\/User