{"sections":[],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"CDPCore supports multiple authentication methods. Each method follows a two-step flow: initiate, then verify.","type":"text"}]},{"level":3,"type":"heading","text":"Email OTP","anchor":"Email-OTP"},{"type":"codeListing","code":["\/\/ Step 1: Initiate","let result = try await client.signInWithEmail(","    SignInWithEmailOptions(email: \"user@example.com\")",")","","\/\/ Step 2: Verify the OTP code the user received","let verified = try await client.verifyEmailOTP(","    VerifyEmailOTPOptions(flowId: result.flowId, otp: \"123456\")",")","print(\"Signed in as \\(verified.user.userId)\")"],"syntax":"swift"},{"level":3,"type":"heading","text":"SMS OTP","anchor":"SMS-OTP"},{"type":"codeListing","code":["let result = try await client.signInWithSms(","    SignInWithSmsOptions(phoneNumber: \"+14155551234\")",")","let verified = try await client.verifySmsOTP(","    VerifySmsOTPOptions(flowId: result.flowId, otp: \"123456\")",")"],"syntax":"swift"},{"level":3,"type":"heading","text":"OAuth (Google, Apple)","anchor":"OAuth-Google-Apple"},{"type":"codeListing","code":["\/\/ Opens the system browser for OAuth","try await client.signInWithOAuth(providerType: .google)","","\/\/ Listen for OAuth completion","await client.onOAuthStateChange { state in","    guard let state, state.status == .success else { return }","    let verified = try await client.verifyOAuth(","        VerifyOAuthOptions(","            flowId: state.flowId!,","            code: state.code!,","            providerType: state.providerType!","        )","    )","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"Custom JWT","anchor":"Custom-JWT"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using "},{"identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/CustomAuth","isActive":true,"type":"reference"},{"type":"text","text":", authentication happens automatically via the JWT callback:"}]},{"type":"codeListing","code":["let config = CDPCoreConfig(","    projectId: \"your-project-id\",","    customAuth: CustomAuth(getJwt: { try await myAuthService.getToken() })",")","let client = try WalletsClient(config: config)","await client.start() \/\/ Authenticates automatically"],"syntax":"swift"},{"level":3,"type":"heading","text":"Session Management","anchor":"Session-Management"},{"type":"codeListing","code":["\/\/ Check sign-in state","let signedIn = try await client.isSignedIn()","","\/\/ Get current user","let user = try await client.getCurrentUser()","","\/\/ Listen for auth state changes. The returned token can be used to unsubscribe.","let listenerId = await client.onAuthStateChange { user in","    if let user {","        print(\"Signed in: \\(user.userId)\")","    } else {","        print(\"Signed out\")","    }","}","","\/\/ Later, stop receiving auth state changes.","await client.removeAuthStateChangeListener(listenerId)","","\/\/ Sign out","try await client.signOut()"],"syntax":"swift"},{"level":3,"type":"heading","text":"Access Tokens","anchor":"Access-Tokens"},{"type":"codeListing","code":["\/\/ Get the current access token (auto-refreshes if needed)","let token = try await client.getAccessToken()","","\/\/ Force a refresh","let freshToken = try await client.getAccessToken(forceRefresh: true)","","\/\/ Check expiration","let expiration = try await client.getAccessTokenExpiration()"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/CDPCore\/documentation\/CDPCore"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cdpcore\/authenticationguide"]}],"abstract":[{"type":"text","text":"Authenticate users with email, SMS, OAuth, or a custom JWT."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CDPCore\/documentation\/CDPCore\/AuthenticationGuide"},"metadata":{"role