{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"After authentication, users can sign messages, hashes, transactions, and EIP-712 typed data with their EVM or Solana accounts.","type":"text"}]},{"text":"EVM Message Signing","level":3,"type":"heading","anchor":"EVM-Message-Signing"},{"syntax":"swift","type":"codeListing","code":["let user = try await client.getCurrentUser()","guard let account = user.evmAccountObjects?.first else { return }","","let result = try await client.signEvmMessage(","    SignEvmMessageOptions(evmAccount: account.address, message: \"Hello, world!\")",")","print(\"Signature: \\(result.signature)\")"]},{"text":"EVM Transaction Signing","level":3,"type":"heading","anchor":"EVM-Transaction-Signing"},{"syntax":"swift","type":"codeListing","code":["let result = try await client.signEvmTransaction(","    SignEvmTransactionOptions(","        evmAccount: account.address,","        transaction: EvmTransaction(","            chainId: 84532,","            to: \"0xRecipient...\",","            value: \"0x0\"","        )","    )",")"]},{"text":"Sending EVM Transactions","level":3,"type":"heading","anchor":"Sending-EVM-Transactions"},{"syntax":"swift","type":"codeListing","code":["let result = try await client.sendEvmTransaction(","    SendEvmTransactionOptions(","        evmAccount: account.address,","        network: .baseSepolia,","        transaction: EvmTransaction(to: \"0xRecipient...\", value: \"0x0\")","    )",")","print(\"TX hash: \\(result.transactionHash)\")"]},{"text":"EIP-712 Typed Data","level":3,"type":"heading","anchor":"EIP-712-Typed-Data"},{"syntax":"swift","type":"codeListing","code":["let result = try await client.signEvmTypedData(","    SignEvmTypedDataOptions(","        evmAccount: account.address,","        typedData: EIP712TypedData(","            domain: EIP712Domain(name: \"MyApp\", version: \"1\", chainId: 84532),","            t