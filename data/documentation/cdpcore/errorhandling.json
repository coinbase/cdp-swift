{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"All SDK errors are thrown as "},{"type":"reference","identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/CDPCoreError","isActive":true},{"type":"text","text":", a Swift enum with associated values providing context about what went wrong."}],"type":"paragraph"},{"level":3,"anchor":"Error-Types","type":"heading","text":"Error Types"},{"type":"codeListing","syntax":"swift","code":["do {","    try await client.signEvmMessage(options)","} catch let error as CDPCoreError {","    switch error {","    case .notInitialized(let msg):","        \/\/ SDK not started — call client.start() first","        print(\"Not initialized: \\(msg)\")","","    case .notSignedIn(let msg):","        \/\/ User needs to authenticate","        print(\"Not signed in: \\(msg)\")","","    case .accountNotFound(let msg):","        \/\/ The specified account doesn't exist for this user","        print(\"Account not found: \\(msg)\")","","    case .inputValidation(let msg):","        \/\/ Invalid parameters passed to the SDK","        print(\"Validation: \\(msg)\")","","    case .api(let statusCode, let errorType, let message, let correlationId):","        \/\/ Server returned an error","        print(\"API error [\\(statusCode)] \\(errorType): \\(message)\")","        if let id = correlationId {","            print(\"Correlation ID: \\(id)\")  \/\/ Useful for support","        }","","    case .network(let msg):","        \/\/ Network connectivity issue","        print(\"Network: \\(msg)\")","","    case .mfa(let code, let msg):","        \/\/ MFA-related error","        switch code {","        case .superseded: print(\"MFA request replaced\")","        case .cancelled: print(\"MFA cancelled\")","        case .listenerRequired: print(\"Register an MFA listener first\")","        }","","    case .swap(let code, let msg):","        \/\/ Swap-related error","        print(\"Swap error (\\(code)): \\(msg)\")","","    case .customAuth(let msg):","        \/\/ Custom JWT provider error","        print(\"Custom auth: \\(msg)\")","","    case .alreadySignedIn(let msg):","        \/\/ Attempted sign-in while already authenticated","        print(\"Already signed in: \\(msg)\")","","    default:","        print(error.localizedDescription)","    }","}"]},{"level":3,"anchor":"LocalizedError-Conformance","type":"heading","text":"LocalizedError Conformance"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/CDPCoreError","type":"reference"},{"text":" conforms to ","type":"text"},{"code":"LocalizedError","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"error.localizedDescription","type":"codeVoice"},{"text":" always returns a human-readable message.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Error-Documentation","type":"heading","text":"Error Documentation"},{"inlineContent":[{"type":"text","text":"For detailed error codes and troubleshooting, see the "},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.cdp.coinbase.com\/errors"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/CDPCore\/documentation\/CDPCore"]]},"sections":[],"variants":[{"paths":["\/documentation\/cdpcore\/errorhandling"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Handle errors from the CDPCore SDK.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/CDPCore\/documentation\/CDPCore\/CDPCoreError","doc:\/\/CDPCore\/documentation\/CDPCore\/MfaErrorCode","doc:\/\/CDPCore\/documentation\/CDPCore\/SwapErrorCode"],"anchor":"Error-Handling","title":"Error Handling"}],"metadata":{"roleHeading":"Article","title":"Error Handling","role":"article","modules":[{"name":"CDPCore"}]},"kind":"article","identifier":{"url":"doc:\/\/CDPCore\/documentation\/CDPCore\/ErrorHandling","interfaceLanguage":"swift"},"references":{"doc://CDPCore/documentation/CDPCore/MfaErrorCode":{"url":"\/documentation\/cdpcore\/mfaerrorcode","abstract":[{"text":"Error codes for MFA-related errors.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"MfaErrorCode","kind":"identifier"}],"title":"MfaErrorCode","navigatorTitle":[{"text":"MfaErrorCode","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/MfaErrorCode"},"doc://CDPCore/documentation/CDPCore/CDPCoreError":{"abstract":[{"type":"text","text":"Errors thrown by the CDPCore SDK."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CDPCoreError"}],"title":"CDPCoreError","navigatorTitle":[{"text":"CDPCoreError","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/cdpcore\/cdpcoreerror","identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/CDPCoreError","type":"topic"},"doc://CDPCore/documentation/CDPCore/SwapErrorCode":{"abstract":[{"text":"Error codes for swap-related errors.","type":"text"}],"identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/SwapErrorCode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwapErrorCode","kind":"identifier"}],"title":"SwapErrorCode","navigatorTitle":[{"text":"SwapErrorCode","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/cdpcore\/swaperrorcode","kind":"symbol"},"https://docs.cdp.coinbase.com/errors":{"url":"https:\/\/docs.cdp.coinbase.com\/errors","identifier":"https:\/\/docs.cdp.coinbase.com\/errors","title":"CDP error documentation","type":"link","titleInlineContent":[{"type":"text","text":"CDP error documentation"}]},"doc://CDPCore/documentation/CDPCore":{"identifier":"doc:\/\/CDPCore\/documentation\/CDPCore","kind":"symbol","title":"CDPCore","abstract":[{"text":"Embedded wallets SDK for the Coinba