{"identifier":{"url":"doc:\/\/CDPCore\/documentation\/CDPCore\/ErrorHandling","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/CDPCore\/documentation\/CDPCore"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All SDK errors are thrown as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/CDPCoreError"},{"type":"text","text":", a Swift enum with associated values providing context about what went wrong."}]},{"type":"heading","anchor":"Error-Types","level":3,"text":"Error Types"},{"type":"codeListing","code":["do {","    try await client.signEvmMessage(options)","} catch let error as CDPCoreError {","    switch error {","    case .notInitialized(let msg):","        \/\/ SDK not started — call client.start() first","        print(\"Not initialized: \\(msg)\")","","    case .notSignedIn(let msg):","        \/\/ User needs to authenticate","        print(\"Not signed in: \\(msg)\")","","    case .accountNotFound(let msg):","        \/\/ The specified account doesn't exist for this user","        print(\"Account not found: \\(msg)\")","","    case .inputValidation(let msg):","        \/\/ Invalid parameters passed to the SDK","        print(\"Validation: \\(msg)\")","","    case .api(let statusCode, let errorType, let message, let correlationId):","        \/\/ Server returned an error","        print(\"API error [\\(statusCode)] \\(errorType): \\(message)\")","        if let id = correlationId {","            print(\"Correlation ID: \\(id)\")  \/\/ Useful for support","        }","","    case .network(let msg):","        \/\/ Network connectivity issue","        print(\"Network: \\(msg)\")","","    case .mfa(let code, let msg):","        \/\/ MFA-related error","        switch code {","        case .superseded: print(\"MFA request replaced\")","        case .cancelled: print(\"MFA cancelled\")","        case .listenerRequired: print(\"Register an MFA listener first\")","        }","","    case .swap(let code, let msg):","        \/\/ Swap-related error","        print(\"Swap error (\\(code)): \\(msg)\")","","    case .customAuth(let msg):","        \/\/ Custom JWT provider error","        print(\"Custom auth: \\(msg)\")","","    case .alreadySignedIn(let msg):","        \/\/ Attempted sign-in while already authenticated","        print(\"Already signed in: \\(msg)\")","","    default:","        print(error.localizedDescription)","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"LocalizedError-Conformance","level":3,"text":"LocalizedError Conformance"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/CDPCore\/documentation\/CDPCore\/CDPCoreError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"LocalizedError"},{"type":"text","text":", so "},{"type":"codeVoice","code":"error.localizedDescription"},{"type":"text","text":" always returns a human-readable message."}]},{"type":"heading","anchor":"Error-Documentation","level":3,"text":"Error Documentation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For detailed error codes and troubleshooting, see the "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.cdp.coinbase.com\/errors"},{"type":"text","text":"."}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/CDPCore\/documentation\/CDPCore\/CDPCoreError","doc:\/\/CDPCore\/documentation\/CDPCore\/MfaErrorCode","doc:\/\/CDPCore\/documentation\/CDPCore\/SwapErrorCode"],"generated":true,"anchor":"Error-Handling","title":"Error Handling"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"Error Handling","modules":[{"name":"CDPCore"}],"roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cdpcore\/errorhandling"]}],"abstract":[{"type":"text","text":"Handle errors from 